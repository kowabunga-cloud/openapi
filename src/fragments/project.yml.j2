{%- import "src/oas.macros.yml.j2" as oas with context %}

components:
  schemas:
{% call oas.Resource(resources.project, ['name', 'teams', 'regions']) %}
{{ oas.StringProperty('domain', 'Internal domain name (e.g. myproject.acme.com)', immutable=True) }}
{{ oas.StringProperty('root_password', 'Default root password, set at cloud-init instance bootstrap phase. Will be randomly auto-generated at each instance creation if unspecified', writeOnly=True) }}
{{ oas.StringProperty('bootstrap_user', "Default service user name, created at cloud-init instance bootstrap phase. Will use Kowabunga's default configuration one if unspecified") }}
{{ oas.StringProperty('bootstrap_pubkey', "Default public SSH key, to be associated to bootstrap user. Will use Kowabunga's default configuration one if unspecified") }}
{{ oas.StringArrayProperty('tags', 'A list of tags to be associated to the project') }}
{{ oas.ObjectArrayProperty('metadatas', 'A list of metadata to be associated to the project', resources.metadata.schema) }}
{{ oas.ObjectProperty('quotas', 'The global project resource quotas (0 for unlimited)', resources.project_resources.schema) }}
{{ oas.ObjectArrayProperty('private_subnets', 'The assigned project VPC private subnets IDs', resources.region_subnet.schema, readOnly=True) }}
{{ oas.IntArrayProperty('reserved_vrrp_ids', 'The list of VRRP IDs used by -as-a-service resources within the project virtual network. Should your application use VRRP for service redundancy, you should use different IDs to prevent issues', readOnly=True) }}
{{ oas.StringArrayProperty('teams', 'A list of user teams allowed to administrate the project (i.e. capable of managing internal resources)') }}
{{ oas.StringArrayProperty('regions', 'A list of Kowabunga regions the project is managing resources from') }}
{% endcall %}

{{ oas.Schema(resources.project_resources) }}
{{ oas.ShortIntProperty('vcpus', 'The total number of vCPUs consumed by (or allowed for) the sum of all instances', minimum=0) }}
{{ oas.IntProperty('memory', 'The total memory (in bytes) consumed by (or allowed for) the sum of all instances', minimum=0) }}
{{ oas.IntProperty('storage', 'The total disk capacity (in bytes) consumed by (or allowed for) the sum of all volumes', minimum=0) }}
{{ oas.ShortIntProperty('instances', 'The number of instances spawned (or allowed to be)', minimum=0) }}

  parameters:
{{ oas.PathParamID(resources.project) }}

paths:
  /project:
{{ oas.LC(resources.project, [resources.project.tag], createParams=['OptionalQuery' + resources.subnet.paramSubnetSizeSchema]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}:
{{ oas.RUD(resources.project, [resources.project.tag], [resources.project.paramSchema]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/cost:
{{ oas.Parameters([resources.project.paramSchema]) }}
{{ oas.Read('Read' + resources.project.schema + resources.cost.schema, resources.cost.schema, resources.cost.desc, [resources.project.tag]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/usage:
{{ oas.Parameters([resources.project.paramSchema]) }}
{{ oas.Read('Read' + resources.project.schema + 'Usage', resources.project_resources.schema, resources.project_resources.desc, [resources.project.tag]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/kwarantine:
{{ oas.Parameters([resources.project.paramSchema]) }}
{{ oas.Create('Create' + resources.project.schema + resources.kwarantine.schema, resources.kwarantine.schema, resources.kwarantine.desc, [resources.project.tag, resources.kwarantine.tag]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/kwarantines:
{{ oas.Parameters([resources.project.paramSchema]) }}
{{ oas.GetAll('List' + resources.project.schema + oas.Plural(resources.kwarantine), resources.kwarantine.desc, [resources.project.tag, resources.kwarantine.tag], True) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/record:
{{ oas.Parameters([resources.project.paramSchema]) }}
{{ oas.Create('Create' + resources.project.schema + resources.record.schema, resources.record.schema, resources.record.desc, [resources.project.tag, resources.record.tag]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/records:
{{ oas.Parameters([resources.project.paramSchema]) }}
{{ oas.GetAll('List' + resources.project.schema + oas.Plural(resources.record), resources.record.desc, [resources.project.tag, resources.record.tag], True) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/region/{{ '{' + resources.region.paramId + '}' }}/volume:
{{ oas.Parameters([resources.project.paramSchema, resources.region.paramSchema, 'OptionalQuery' + resources.pool.paramSchema, 'OptionalQuery' + resources.template.paramSchema]) }}
{{ oas.Create('Create' + resources.project.schema + resources.region.schema + resources.volume.schema, resources.volume.schema, resources.volume.desc, [resources.project.tag, resources.region.tag, resources.volume.tag]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/region/{{ '{' + resources.region.paramId + '}' }}/volumes:
{{ oas.Parameters([resources.project.paramSchema, resources.region.paramSchema]) }}
{{ oas.GetAll('List' + resources.project.schema + resources.region.schema + oas.Plural(resources.volume), resources.volume.desc, [resources.project.tag, resources.region.tag, resources.volume.tag], True) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/zone/{{ '{' + resources.zone.paramId + '}' }}/instance:
{{ oas.Parameters([resources.project.paramSchema, resources.zone.paramSchema]) }}
{{ oas.Create('Create' + resources.project.schema + resources.zone.schema + resources.instance.schema, resources.instance.schema, resources.instance.desc, [resources.project.tag, resources.zone.tag, resources.instance.tag]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/zone/{{ '{' + resources.zone.paramId + '}' }}/instances:
{{ oas.Parameters([resources.project.paramSchema, resources.zone.paramSchema]) }}
{{ oas.GetAll('List' + resources.project.schema + resources.zone.schema + oas.Plural(resources.instance), resources.instance.desc, [resources.project.tag, resources.zone.tag, resources.instance.tag], True) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/region/{{ '{' + resources.region.paramId + '}' }}/instance:
{{ oas.Parameters([resources.project.paramSchema, resources.region.paramSchema]) }}
{{ oas.Create('Create' + resources.project.schema + resources.region.schema + resources.instance.schema, resources.instance.schema, resources.instance.desc, [resources.project.tag, resources.region.tag, resources.instance.tag]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/region/{{ '{' + resources.region.paramId + '}' }}/instances:
{{ oas.Parameters([resources.project.paramSchema, resources.region.paramSchema]) }}
{{ oas.GetAll('List' + resources.project.schema + resources.region.schema + oas.Plural(resources.instance), resources.instance.desc, [resources.project.tag, resources.region.tag, resources.instance.tag], True) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/zone/{{ '{' + resources.zone.paramId + '}' }}/kompute:
{{ oas.Parameters([resources.project.paramSchema, resources.zone.paramSchema, 'OptionalQuery' + resources.pool.paramSchema, 'OptionalQuery' + resources.template.paramSchema, 'OptionalQuery' + resources.kompute.paramPublicSchema]) }}
{{ oas.Create('Create' + resources.project.schema + resources.zone.schema + resources.kompute.schema, resources.kompute.schema, resources.kompute.desc, [resources.project.tag, resources.zone.tag, resources.kompute.tag]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/zone/{{ '{' + resources.zone.paramId + '}' }}/komputes:
{{ oas.Parameters([resources.project.paramSchema, resources.zone.paramSchema]) }}
{{ oas.GetAll('List' + resources.project.schema + resources.zone.schema + oas.Plural(resources.kompute), resources.kompute.desc, [resources.project.tag, resources.zone.tag, resources.kompute.tag], True) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/region/{{ '{' + resources.region.paramId + '}' }}/kompute:
{{ oas.Parameters([resources.project.paramSchema, resources.region.paramSchema, 'OptionalQuery' + resources.pool.paramSchema, 'OptionalQuery' + resources.template.paramSchema, 'OptionalQuery' + resources.kompute.paramPublicSchema]) }}
{{ oas.Create('Create' + resources.project.schema + resources.region.schema + resources.kompute.schema, resources.kompute.schema, resources.kompute.desc, [resources.project.tag, resources.region.tag, resources.kompute.tag]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/region/{{ '{' + resources.region.paramId + '}' }}/komputes:
{{ oas.Parameters([resources.project.paramSchema, resources.region.paramSchema]) }}
{{ oas.GetAll('List' + resources.project.schema + resources.region.schema + oas.Plural(resources.kompute), resources.kompute.desc, [resources.project.tag, resources.region.tag, resources.kompute.tag], True) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/region/{{ '{' + resources.region.paramId + '}' }}/kylo:
{{ oas.Parameters([resources.project.paramSchema, resources.region.paramSchema]) }}
{{ oas.Create('Create' + resources.project.schema + resources.region.schema + resources.kylo.schema, resources.kylo.schema, resources.kylo.desc, [resources.project.tag, resources.region.tag, resources.kylo.tag], params=['OptionalQuery' + resources.nfs.paramSchema]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/region/{{ '{' + resources.region.paramId + '}' }}/kylos:
{{ oas.Parameters([resources.project.paramSchema, resources.region.paramSchema, 'OptionalQuery' + resources.nfs.paramSchema]) }}
{{ oas.GetAll('List' + resources.project.schema + resources.region.schema + oas.Plural(resources.kylo), resources.kylo.desc, [resources.project.tag, resources.region.tag, resources.kylo.tag], True) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/region/{{ '{' + resources.region.paramId + '}' }}/kawaii:
{{ oas.Parameters([resources.project.paramSchema, resources.region.paramSchema]) }}
{{ oas.Create('Create' + resources.project.schema + resources.region.schema + resources.kawaii.schema, resources.kawaii.schema, resources.kawaii.desc, [resources.project.tag, resources.region.tag, resources.kawaii.tag]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/region/{{ '{' + resources.region.paramId + '}' }}/kawaiis:
{{ oas.Parameters([resources.project.paramSchema, resources.region.paramSchema]) }}
{{ oas.GetAll('List' + resources.project.schema + resources.region.schema + oas.Plural(resources.kawaii), resources.kawaii.desc, [resources.project.tag, resources.region.tag, resources.kawaii.tag], True) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/zone/{{ '{' + resources.zone.paramId + '}' }}/konvey:
{{ oas.Parameters([resources.project.paramSchema, resources.zone.paramSchema]) }}
{{ oas.Create('Create' + resources.project.schema + resources.zone.schema + resources.konvey.schema, resources.konvey.schema, resources.konvey.desc, [resources.project.tag, resources.zone.tag, resources.konvey.tag]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/zone/{{ '{' + resources.zone.paramId + '}' }}/konveys:
{{ oas.Parameters([resources.project.paramSchema, resources.zone.paramSchema]) }}
{{ oas.GetAll('List' + resources.project.schema + resources.zone.schema + oas.Plural(resources.konvey), resources.konvey.desc, [resources.project.tag, resources.zone.tag, resources.konvey.tag], True) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/region/{{ '{' + resources.region.paramId + '}' }}/konvey:
{{ oas.Parameters([resources.project.paramSchema, resources.region.paramSchema]) }}
{{ oas.Create('Create' + resources.project.schema + resources.region.schema + resources.konvey.schema, resources.konvey.schema, resources.konvey.desc, [resources.project.tag, resources.region.tag, resources.konvey.tag]) }}

  /project/{{ '{' + resources.project.paramId + '}' }}/region/{{ '{' + resources.region.paramId + '}' }}/konveys:
{{ oas.Parameters([resources.project.paramSchema, resources.region.paramSchema]) }}
{{ oas.GetAll('List' + resources.project.schema + resources.region.schema + oas.Plural(resources.konvey), resources.konvey.desc, [resources.project.tag, resources.region.tag, resources.konvey.tag], True) }}

{%- import "src/oas.macros.yml.j2" as oas with context %}

components:
  schemas:
{% call oas.Resource(resources.agent, ['name', 'type']) %}
{{ oas.StringProperty('type', 'The Kowabunga agent type', values=['Kaktus', 'Kiwi', 'Kontroller'], immutable=True) }}
{% endcall %}

  parameters:
{{ oas.PathParamID(resources.agent) }}

paths:
  /agent:
{{ oas.LC(resources.agent, [resources.agent.tag]) }}

  /agent/{{ '{' + resources.agent.paramId + '}' }}:
{{ oas.RUD(resources.agent, [resources.agent.tag], [resources.agent.paramSchema]) }}

  /agent/{{ '{' + resources.agent.paramId + '}' }}/token:
{{ oas.Parameters([resources.agent.paramSchema, 'OptionalQueryExpire', 'OptionalQueryExpirationDate']) }}
{{ oas.Patch('Set' + resources.agent.schema + resources.token.schema, resources.agent.desc, 'setting of API token (will replace any existing one, disconnecting the agent; the generated API key is only sent once, by email, to administrators)', [resources.agent.tag, resources.token.tag], resources.token.schema, resources.token.desc) }}
